# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment files (uncomment if these contain sensitive data)
# .env
# .env.dev
# .env.prod

# Generated files
*.g.dart
*.freezed.dart

# Firebase
# firebase_options.dart (uncomment to exclude if you don't want to commit Firebase config)

# Android signing files - NEVER commit these!
/android/key.properties
/android/app/upload-keystore.jks
*.jks
*.keystore
